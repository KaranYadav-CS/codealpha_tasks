# ==============================================================================
# CodeAlpha Cyber Security Internship - Task 4: Network Intrusion Detection
# Custom Suricata Detection Rules (local.rules)
# Compatible with Suricata 7.x
#
# Rule SID Allocation Range: 1000001 - 1000099 (Local Lab Signatures)
# All testing is strictly confined to synthetic, non-malicious lab traffic
# adhering to RFC 5737 and RFC 1918 documentation IP address ranges.
# ==============================================================================

# ------------------------------------------------------------------------------
# Demonstration 1: Unique Harmless Marker in Synthetic Lab Packet
# Purpose: Validates that Suricata's HTTP protocol decoder correctly parses
#          the request URI buffer and triggers on an explicit telemetry marker.
# Severity: Low / Informational (classtype: misc-activity)
# ------------------------------------------------------------------------------
alert http any any -> any any (msg:"CODEALPHA LAB - Unique Telemetry Lab Marker Detected"; flow:to_server; http.method; content:"GET"; http.uri; content:"/test-marker/alpha-telemetry"; classtype:misc-activity; sid:1000001; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 2: Suspicious Automated Infiltration / Reconnaissance User-Agent
# Purpose: Detects automated attack tooling or custom port/vulnerability scanners
#          announcing a recognizable non-browser User-Agent string.
# Severity: Medium (classtype: attempted-recon)
# ------------------------------------------------------------------------------
alert http any any -> any any (msg:"CODEALPHA LAB - Suspicious Reconnaissance User-Agent Header"; flow:to_server; http.header; content:"User-Agent: AlphaInfiltrationScanner/1.0"; classtype:attempted-recon; sid:1000002; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 3: Controlled TCP SYN Port Sweep Probe
# Purpose: Detects TCP SYN packets with no payload (dsize:0) directed at non-web
#          administrative ports (FTP, SSH, Telnet, RDP), characteristic of initial
#          stealth port mapping (e.g. Nmap -sS).
# Options: flags:S,12 matches SYN bit with SYN/RST/ACK mask.
# Severity: Medium (classtype: attempted-recon)
# ------------------------------------------------------------------------------
alert tcp any any -> any [21,22,23,3389,8080] (msg:"CODEALPHA LAB - Reconnaissance TCP SYN Port Sweep Probe"; flags:S,12; flow:stateless; dsize:0; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:1000003; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 4: Suspicious TCP XMAS Tree Scan Probe
# Purpose: Detects TCP packets with FIN, PSH, and URG flags set simultaneously.
#          RFC 793 standard TCP stacks drop or respond to these uniquely, making
#          them a classic signature of stealth OS/port fingerprinting (Nmap -sX).
# Severity: High (classtype: attempted-recon)
# ------------------------------------------------------------------------------
alert tcp any any -> any any (msg:"CODEALPHA LAB - Suspicious TCP XMAS Tree Scan Probe"; flags:FPU,12; flow:stateless; classtype:attempted-recon; sid:1000004; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 5: Suspicious TCP NULL Scan Probe
# Purpose: Detects packets with zero TCP control flags set (flags:0).
#          Used by attackers (e.g. Nmap -sN) to bypass basic stateless filters.
# Severity: High (classtype: attempted-recon)
# ------------------------------------------------------------------------------
alert tcp any any -> any any (msg:"CODEALPHA LAB - Suspicious TCP NULL Scan Probe"; flags:0,12; flow:stateless; classtype:attempted-recon; sid:1000005; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 6: Suspicious Canary DNS Query Resolution
# Purpose: Detects DNS lookup attempts for a canary domain used in controlled
#          out-of-band application testing or command-and-control beacon analysis.
# Severity: Medium (classtype: bad-unknown)
# ------------------------------------------------------------------------------
alert dns any any -> any 53 (msg:"CODEALPHA LAB - Suspicious DNS Query to Canary Domain"; dns.query; content:"canary-recon.codealpha.test"; nocase; classtype:bad-unknown; sid:1000006; rev:1;)

# ------------------------------------------------------------------------------
# Demonstration 7: Simulated Web Shell / Command Injection POST Parameter
# Purpose: Detects HTTP POST payloads containing simulated OS shell command execution
#          patterns commonly found in web application compromise attempts.
# Severity: Critical (classtype: attempted-admin)
# ------------------------------------------------------------------------------
alert http any any -> any any (msg:"CODEALPHA LAB - Potential Web Shell Command Execution Detected"; flow:to_server; http.method; content:"POST"; http.request_body; content:"cmd=whoami"; classtype:attempted-admin; sid:1000007; rev:1;)
